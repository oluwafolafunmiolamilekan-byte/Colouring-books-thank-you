<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Thank You for Your Purchase</title>

  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f8f3fb;
      margin: 0;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .card {
      background: white;
      max-width: 520px;
      margin: 20px;
      padding: 40px 28px;
      border-radius: 20px;
      text-align: center;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
    }

    h1 {
      color: #65156f;
      margin-bottom: 12px;
    }

    p {
      color: #555;
      line-height: 1.6;
    }

    .note {
      background: #f5eafa;
      padding: 15px;
      border-radius: 12px;
      margin: 22px 0;
    }

    .emoji {
      font-size: 45px;
    }
  </style>
</head>

<body>

  <div class="card">

    <div class="emoji">🎉</div>

    <h1>Thank You for Your Purchase!</h1>

    <p>
      Your children's coloring book purchase was successful.
    </p>

    <div class="note">
      <p>
        <strong>Your coloring book is ready!</strong>
      </p>

      <p>
        Check your Selar purchase confirmation for the download link.
      </p>
    </div>

    <p>
      Have fun coloring! 🖍️✨
    </p>

  </div>

</body>
</html>